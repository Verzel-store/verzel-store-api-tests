          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status Code deve ser 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Subtotal deve ser R$ 239,70\", () => {\r\n    pm.expect(response.subtotal).to.eql(239.7);\r\n});\r\n\r\npm.test(\"Desconto deve ser R$ 23,97 (10%)\", () => {\r\n    pm.expect(response.desconto).to.eql(23.97);\r\n});\r\n\r\npm.test(\"Frete deve ser grátis\", () => {\r\n    pm.expect(response.frete).to.eql(0);\r\n});\r\n\r\npm.test(\"Frete grátis deve ser verdadeiro\", () => {\r\n    pm.expect(response.freteGratis).to.be.true;\r\n});\r\n\r\npm.test(\"Valor faltante para frete grátis deve ser 0\", () => {\r\n    pm.expect(response.valorFaltanteFreteGratis).to.eql(0);\r\n});\r\n\r\npm.test(\"Total deve ser R$ 215,73\", () => {\r\n    pm.expect(response.total).to.eql(215.73);\r\n});\r\n\r\npm.test(\"Cupom deve estar aplicado\", () => {\r\n    pm.expect(response.cupom.aplicado).to.be.true;\r\n});\r\n\r\npm.test(\"Código do cupom deve ser BEMVINDO10\", () => {\r\n    pm.expect(response.cupom.codigo).to.eql(\"BEMVINDO10\");\r\n});\r\n\r\npm.test(\"Mensagem do cupom deve estar correta\", () => {\r\n    pm.expect(response.cupom.mensagem)\r\n        .to.eql(\"Cupom aplicado: 10% de desconto nos produtos.\");\r\n});\r\n\r\npm.test(\"Deve retornar os dois itens do carrinho\", () => {\r\n    pm.expect(response.itens.length).to.eql(2);\r\n});\r\n\r\npm.test(\"Primeiro item deve ser P002\", () => {\r\n    pm.expect(response.itens[0].produtoId).to.eql(\"P002\");\r\n    pm.expect(response.itens[0].quantidade).to.eql(1);\r\n    pm.expect(response.itens[0].total).to.eql(139.9);\r\n});\r\n\r\npm.test(\"Segundo item deve ser P004\", () => {\r\n    pm.expect(response.itens"
