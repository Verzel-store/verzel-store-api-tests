                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\n\r\npm.test(\"Status Code deve ser 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Cupom deve ser aplicado com sucesso\", function () {\r\n    pm.expect(response.cupom.aplicado).to.eql(true);\r\n});\r\n\r\npm.test(\"Código do cupom deve ser BEMVINDO10\", function () {\r\n    pm.expect(response.cupom.codigo).to.eql(\"BEMVINDO10\");\r\n});\r\n\r\npm.test(\"Mensagem do cupom deve estar correta\", function () {\r\n    pm.expect(response.cupom.mensagem)\r\n        .to.eql(\"Cupom aplicado: 10% de desconto nos produtos.\");\r\n});\r\n\r\npm.test(\"Subtotal deve ser 100,00\", function () {\r\n    pm.expect(response.subtotal).to.eql(100);\r\n});\r\n\r\npm.test(\"Desconto deve ser 10,00\", function () {\r\n    pm.expect(response.desconto).to.eql(10);\r\n});\r\n\r\npm.test(\"Frete deve ser 19,90\", function () {\r\n    pm.expect(response.frete).to.eql(19.9);\r\n});\r\n\r\npm.test(\"Frete grátis deve ser false\", function () {\r\n    pm.expect(response.freteGratis).to.eql(false);\r\n});\r\n\r\npm.test(\"Valor faltante para frete grátis deve ser 100,00\", function () {\r\n    pm.expect(response.valorFaltanteFreteGratis).to.eql(100);\r\n});\r\n\r\npm.test(\"Total deve ser 109,90\", function () {\r\n    pm.expect(response.total).to.eql(109.9);\r\n});"
