              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\n\r\npm.test(\"Status Code deve ser 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Subtotal deve ser exatamente R$ 200,00\", () => {\r\n    pm.expect(response.subtotal).to.eql(200);\r\n});\r\n\r\npm.test(\"Frete deve ser R$ 0,00 para subtotal igual a R$ 200,00\", () => {\r\n    pm.expect(response.frete).to.eql(0);\r\n});\r\n\r\npm.test(\"Frete grátis deve ser true para subtotal igual a R$ 200,00\", () => {\r\n    pm.expect(response.freteGratis).to.eql(true);\r\n});\r\n\r\npm.test(\"Valor faltante para frete grátis deve ser 0\", () => {\r\n    pm.expect(response.valorFaltanteFreteGratis).to.eql(0);\r\n});\r\n\r\npm.test(\"Total deve ser igual ao subtotal quando não há desconto nem frete\", () => {\r\n    pm.expect(response.total).to.eql(200);\r\n});\r\n"
